---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav style="display: flex !important; align-items: center !important; justify-content: space-between !important; width: 100%;">
		<h2><a href="/"><img src="/logo_haikeitouka.png" alt={SITE_TITLE} style="height: 70px; width: auto;" /></a></h2>
		<div class="internal-links" style="display: flex !important; margin-left: auto !important;">
			<a href="/" style="color: #333333 !important; text-decoration: none !important; font-weight: bold; padding: 0.5em 1em;">Homeに戻る</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		margin-left: auto;
	}
	.internal-links a {
		padding: 0.5em 1em;
		color: #333333;
		text-decoration: none;
		font-size: 1em;
		font-weight: 500;
	}
	.internal-links a:hover {
		color: #bf0000 !important;
	}
</style>
