---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/"><img src="/logo_haikeitouka.png" alt={SITE_TITLE} style="height: 60px; width: auto;" /></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	/* ロゴ画像の下に余計な線が出ないように微調整 */
	h2 a,
	h2 a.active {
		text-decoration: none;
		padding: 0;
		border-bottom: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	
	/* ★修正ポイント：不要な記述を消し、Homeを確実に右へ押しやる設定に変更★ */
	.internal-links {
		display: flex;
		align-items: center;
		margin-left: auto;
	}
</style>
